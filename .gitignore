# CloudNote ignore rules

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist/
apps/*/dist/

# Environment and secrets
.env
.env.local
.env.*.local
!.env.example

# Runtime uploaded files
uploads/*
!uploads/.gitkeep
public/uploads/

# Runtime data
*.db
data/
database/
db/

# Logs and temp files
logs/
*.log
*.tmp
*.temp
tmp/
temp/
.cache/

# Source backup archives
*.zip
*.rar
*.7z
*.tar
*.tar.gz

# Local helper scripts created for one-time GitHub push
cloudnote_push_to_github*.ps1

# OS files
.DS_Store
Thumbs.db

# Editor local settings
.vscode/
.idea/
