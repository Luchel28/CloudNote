# Platform port
API_PORT=3001

# Public base URL
PUBLIC_BASE_URL=http://localhost:3001

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_TOKEN_EXPIRE_HOURS=12

# Database
# Leave empty for frontend/shell-only local startup.
# Set this when you want the full PostgreSQL-backed platform features.
# DATABASE_URL=postgres://cloudnote:cloudnote_dev_password@localhost:5432/cloudnote
CLOUDNOTE_REQUIRE_DATABASE=false
CLOUDNOTE_RUN_MIGRATIONS=false

# Storage
UPLOAD_DIR=./uploads
UPLOAD_TMP_DIR=./uploads/.tmp
MAX_UPLOAD_SIZE_MB=500
MAX_UPLOAD_FILES=20

# Web shell dist paths
WEB_ADMIN_DIST=./apps/web-admin/dist
WEB_STUDENT_DIST=./apps/web-student/dist
