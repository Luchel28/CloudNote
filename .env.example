# 服务监听端口
PORT=3000

# 管理员后台登录密码
# 本地开发可使用默认值 admin123456
# 生产环境 NODE_ENV=production 时必须显式改成非空强密码，不能使用 admin123456
ADMIN_PASSWORD=admin123456

# 管理员登录 token 有效期，单位：小时
ADMIN_TOKEN_EXPIRE_HOURS=12

# SQLite 数据库文件路径；相对路径会基于项目根目录解析
CLOUDNOTE_DB_PATH=./cloudnote.db

# 上传文件保存目录；相对路径会基于项目根目录解析
UPLOAD_DIR=./uploads

# 对外访问地址，用于生成公开任务链接；部署后改成真实域名或公网 IP
PUBLIC_BASE_URL=http://localhost:3000

# 系统级单文件最大上传大小，单位：MB
# 这是服务器安全上限，和单个任务的 enableLimit 文件大小开关不是同一层限制
MAX_UPLOAD_SIZE_MB=500

# 系统级单次最多上传文件数量，默认 20；任务级 maxFiles 不能超过该上限
MAX_UPLOAD_FILES=20
